prop_id = "pumps"
hover_label = "Pumps"
ground_pos = Vector2(-3.0, 5.6)
click_half_size = Vector2(120, 90)
interact_distance = 1.4
lines = PackedStringArray("Two pumps with rounded shoulders and glass globes on top, the red paint sun-bleached to the colour of a sunburn. The dials stop at 1.09 a gallon. PAY INSIDE, in letters someone has scraped half off.", "RECALL|The numbers on the left one are still turning. Very slowly. Nobody's pumping.")

[node name="PayphoneProp" type="Area2D" parent="World"]
position = Vector2(1823.8, 939.9)
script = ExtResource("4")
prop_id = "payphone"
hover_label = "Payphone"
ground_pos = Vector2(-9.0, 7.8)
click_half_size = Vector2(40, 60)
interact_distance = 1.2
lines = PackedStringArray("A payphone in a steel hood. The handset hangs off the hook at the end of its cord, turning slowly in a breeze you can't feel.", "SUSPICION|There's a dial tone. Then, under it, breathing. Then just the dial tone.")

[node name="SignProp" type="Area2D" parent="World"]
position = Vector2(2768.5, 1152.7)
script = ExtResource("4")
prop_id = "pylon_sign"
hover_label = "Sign"
ground_pos = Vector2(8.2, 5.6)
click_half_size = Vector2(90, 120)
interact_distance = 2.0
lines = PackedStringArray("A pylon sign with a starburst on top and GAS in a red ring, the kind they stopped making before you were old enough to drive. The price board under it says 1.09 and has said so long enough to bleach into the panel.")

[node name="CoolerProp" type="Area2D" parent="World"]
